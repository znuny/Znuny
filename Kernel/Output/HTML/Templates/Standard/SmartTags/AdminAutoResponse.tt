## nofilter(TidyAll::Plugin::Znuny::TT::Breadcrumb)

<dt><code class="bold">&lt;ZNUNY_CUSTOMER_SUBJECT[20]&gt;</code></dt>
<dd class="flex-row">
    [% Translate("To get the first 20 character of the subject.") | html %]
</dd>

<dt><code class="bold">&lt;ZNUNY_CUSTOMER_EMAIL[5]&gt;</code></dt>
<dd class="flex-row">
    [% Translate("To get the first 5 lines of the email.") | html %]
</dd>

<dt><code class="bold">&lt;ZNUNY_CUSTOMER_REALNAME&gt;</code></dt>
<dd class="flex-row">
    [% Translate("To get the name of the ticket's customer user (if given).") | html %]
</dd>

<dt><code class="bold">&lt;ZNUNY_CUSTOMER_*&gt;</code></dt>
<dd class="flex-row">
    [% Translate("To get the article attribute") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_CUSTOMER_From&gt;, &lt;ZNUNY_CUSTOMER_To&gt;,
    &lt;ZNUNY_CUSTOMER_Cc&gt;, &lt;ZNUNY_CUSTOMER_Subject&gt;, &lt;ZNUNY_CUSTOMER_BODY&gt;</code>
</dd>

<dt><code class="bold">&lt;ZNUNY_CUSTOMER_DATA_*&gt;</code></dt>
<dd class="flex-row">
    [% Translate("Options of the current customer user data") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_CUSTOMER_DATA_UserFirstname&gt;</code>
</dd>

<dt><code class="bold">&lt;ZNUNY_OWNER_*&gt;</code></dt>
<dd class="flex-row">
    [% Translate("Ticket owner options") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_OWNER_UserFirstname&gt;</code>
</dd>

<dt><code class="bold">&lt;ZNUNY_TICKET_*&gt;</code></dt>
<dd class="flex-row">
    [% Translate("Options of the ticket data") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_TICKET_TicketNumber&gt;, &lt;ZNUNY_TICKET_TicketID&gt;,
    &lt;ZNUNY_TICKET_Queue&gt;, &lt;ZNUNY_TICKET_State&gt;</code>
</dd>

<dt><code class="bold">&lt;ZNUNY_TICKET_DynamicField_*&gt;</code></dt>
<dd class="flex-row">
    [% Translate("Options of ticket dynamic fields internal key values") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_TICKET_DynamicField_TestField&gt;,
    &lt;ZNUNY_TICKET_DynamicField_TicketFreeText1&gt;</code>
</dd>

<dt><code class="bold">&lt;ZNUNY_TICKET_DynamicField_*_Value&gt;</code></dt>
<dd class="flex-row">
    [% Translate("Options of ticket dynamic fields display values, useful for Dropdown and Multiselect fields") | html %]
    [% Translate("e. g.") | html %] <code>&lt;ZNUNY_TICKET_DynamicField_TestField_Value&gt;,
    &lt;ZNUNY_TICKET_DynamicField_TicketFreeText1_Value&gt;</code>
</dd>