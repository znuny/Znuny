[% RenderBlockStart("LinkTableSimple") %]
    <div class="mod modSidebarWidget">
        <div class="inner">
            <div class="sidebarWidgetTitle">
                <h3>[% Translate("Linked Objects") | html %]</h3>
            </div>
            <div class="sidebarWidgetContent">
                <div class="mod modLinkedObjects">
                    <div class="inner">
                        [% Data.LinkTableStrg %]
                    </div>
                </div>
            </div>
        </div>
    </div>
[% RenderBlockEnd("LinkTableSimple") %]
[% RenderBlockStart("LinkTableComplex") %]
    [% Data.LinkTableStrg %]
[% RenderBlockEnd("LinkTableComplex") %]
