## nofilter(TidyAll::Plugin::Znuny::TT::ScriptUsage)

[% TicketFrontendConfig = Config("Ticket::Frontend::" _ Env("Action") ) %]

<div class="layoutPopUp">
    <main class="sectionContent">
        <div class="container-fluid ARIARoleMain" role="main">
            <div class="row">
                <div class="col-xs-12 order-1">
                    <div class="mod modForm" >
                        <div class="inner">
                            <form action="[% Env("CGIHandle") %]" method="post" enctype="multipart/form-data" name="Compose" id="Compose" class="Validate PreventMultipleSubmits">
                                <input type="hidden" name="Action" value="[% Env("Action") %]" />
                                <input type="hidden" name="Subaction" value="SendEmail" />
                                <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]" />
                                <input type="hidden" name="Email" value="[% Data.Email | html %]" />
                                <input type="hidden" name="InReplyTo" value="[% Data.InReplyTo | html %]" />
                                <input type="hidden" name="References" value="[% Data.References | html %]" />
                                <input type="hidden" name="FormID" value="[% Data.FormID | html %]" />
                                <input type="hidden" name="IsVisibleForCustomerPresent" value="1" />
                                <input type="hidden" name="FormDraftTitle" value="[% Data.FormDraftTitle | html %]" />
                                <input type="hidden" name="FormDraftID" value="[% Data.FormDraftID | html %]" />
                                <input type="hidden" name="FormDraftAction" id="FormDraftAction" />

                                <div class="row">
                                    <div class="col-12">
                                        [% RenderBlockStart("PropertiesLockNotify") %]
                                            [% INCLUDE "Modules/Alert.tt"
                                                Data = {
                                                    message   = Translate("The ticket has been locked") _ ".",
                                                    type      = "warning",
                                                    hideAfter = 10,
                                                    actions   = "[
                                                        {
                                                            \"url\": \"" _ Env("Baselink") _ "Action=AgentTicketLock;Subaction=Unlock;TicketID=" _ Data.TicketID _ "" _
                                                            (Data.PreviousOwner ? ";PreviousOwner=" _ Data.PreviousOwner : "") _ ";" _ Env("ChallengeTokenParam") _ "\",
                                                            \"text\": \"" _ Translate("Unlock and close popup") _ "\",
                                                            \"class\": \"UndoClosePopup\",
                                                            \"type\": \"cancel\"
                                                        }
                                                    ]"
                                                }
                                            %]
                                        [% RenderBlockEnd("PropertiesLockNotify") %]
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        [% INCLUDE "FormElements/DraftNotifications.tt" %]
                                    </div>

[% IF Config('Ticket::Service') && TicketFrontendConfig.Service %]
                                    <div class="col-12">
                                        <div class="mod modCard">
                                            <div class="inner">
                                                <div class="cardTitle">
                                                    <h2>[% Translate("Services") | html %]</h2>
                                                    <span class="cardTitleTrigger"></span>
                                                </div>
                                                <div class="cardContent">
                                                    <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-2 gy-3">
[% RenderBlockStart("Service") %]
                                                        <div class="col">
                                                            <label for="ServiceID">[% Translate("Service") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.ServiceStrg %]
                                                                </div>
                                                                <div id="ServiceIDServerError" class="TooltipErrorMessage"><p>[% Translate("Service invalid.") | html %]</p></div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("Service") %]

[% RenderBlockStart("ServiceMandatory") %]
                                                        <div class="col">
                                                            <label class="Mandatory" for="ServiceID"><span class="Marker">*</span>[% Translate("Service") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.ServiceStrg %]
                                                                </div>
                                                                <div id="ServiceIDError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                                                                <div id="ServiceIDServerError" class="TooltipErrorMessage"><p>[% Translate("Service invalid.") | html %]</p></div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("ServiceMandatory") %]

[% RenderBlockStart("SLA") %]
                                                        <div class="col">
                                                            <label for="SLAID">[% Translate("Service Level Agreement") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.SLAStrg %]
                                                                </div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("SLA") %]

[% RenderBlockStart("SLAMandatory") %]
                                                        <div class="col">
                                                            <label class="Mandatory" for="SLAID"><span class="Marker">*</span>[% Translate("Service Level Agreement") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.SLAStrg %]
                                                                </div>
                                                                <div id="SLAIDError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                                                                <div id="SLAIDServerError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("SLAMandatory") %]
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
[% END %]
                                    <div class="cardTicketData col-12">
                                        <div class="mod modCard">
                                            <div class="inner">
                                                <div class="cardTitle">
                                                    <h2>[% Translate("Ticket Data") | html %]</h2>
                                                    <span class="cardTitleTrigger"></span>
                                                </div>
                                                <div class="cardContent">
                                                    <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 gy-3">
[% RenderBlockStart("Type") %]
                                                        <div class="col">
                                                            <label class="Mandatory" for="TypeID"><span class="Marker">*</span>[% Translate("Type") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.TypeStrg %]
                                                                </div>
                                                                <div id="TypeIDError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                                                                <div id="TypeIDServerError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("Type") %]
                                                        <div class="col">
                                                            <label for="ComposeStateID">[% Translate("State") | html %]:</label>
                                                            <div class="Field">
                                                                [% Data.NextStatesStrg %]
                                                            </div>
                                                        </div>
                                                        <div class="col" style="display: none;">
                                                            <label>[% Translate("Pending date") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">[% Data.PendingDateString %]</div>
                                                                <div id="DayServerError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("Date Invalid!") | html %]</p>
                                                                </div>
                                                                <div id="HourServerError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("Date Invalid!") | html %]</p>
                                                                </div>
                                                                <p class="FieldExplanation">[% Translate("For all pending* states.") | html %]</p>
                                                            </div>
                                                        </div>
[% RenderBlockStart("Priority") %]
                                                        <div class="col">
                                                            <label for="NewPriorityID">[% Translate("Priority") | html %]:</label>
                                                            <div class="Field">
                                                                <div class="select-field-wrapper">
                                                                    [% Data.PriorityStrg %]
                                                                </div>
                                                            </div>
                                                        </div>
[% RenderBlockEnd("Priority") %]
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    [% IF !TicketFrontendConfig.DynamicField.empty %]
                                    <div class="cardDynamicField col-12">
                                        <div class="mod modCard">
                                            <div class="inner">
                                                <div class="cardTitle">
                                                    <h2>[% Translate("Dynamic Fields") | html %]</h2>
                                                    <span class="cardTitleTrigger"></span>
                                                </div>
                                                <div class="cardContent">
                                                    <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 gy-3">
                                                        [% RenderBlockStart("DynamicField") %]
                                                        <div class="Row Row_DynamicField_[% Data.Name | html %] dynamicField dynamicField[% Data.Name | html %]">
                                                            <div class="col-12">
                                                                <div class="mod modDynamicField">
                                                                    <div class="inner">
                                                                        <div class="dynamicFieldLabel">
                                                                            [% Data.Label %]
                                                                        </div>
                                                                        <div class="dynamicFieldForm">
                                                                            [% Data.Field %]
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        [% RenderBlockEnd("DynamicField") %]
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    [% END %]
                                    <div class="cardCommunication col-12">
                                        <div class="mod modCard">
                                            <div class="inner">
                                                <div class="cardTitle">
                                                    <h2>[% Translate("Communications") | html %]</h2>
                                                    <span class="cardTitleTrigger"></span>
                                                    <div class="cardTitleAdditionalContent">
                                                        <div class="mod modMessageInformation">
                                                            <div class="inner">
                                                                <div class="messageInformation">
                                                                    <div class="messageInformationLabel">
                                                                        [% Translate("From") | html %]:
                                                                    </div>
                                                                    <div class="messageInformationContent">
                                                                        [% Data.From | html %]
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="cardContent">
                                                    <div class="row gy-3">
                                                        <div class="col-12">
                                                            <div class="mod modCustomerSelector" >
                                                                <div class="inner"
                                                                    data-input-name="CustomerKey_"
                                                                    data-input-text-name="CustomerTicketText_"
                                                                    data-input-customer-queue="CustomerQueue_"
                                                                    data-input-type="customer"
                                                                    data-input-counter-name="CustomerTicketCounterToCustomer"
                                                                    data-input-selected-name="CustomerSelected"
                                                                    data-selected-customer-allow="false"
                                                                    data-selected-customer-field-name="SelectedCustomerUser"
                                                                    data-remove-icon-path="[% Config("Frontend::ImagePath") %]icons/xmark-gray.svg"
                                                                    data-url="[% Env("Baselink") %]Action=AgentCustomerSearch;MaxResults=20"
                                                                    data-customers="[]">

                                                                    <div class="customerSelector" role="form">
                                                                        <div class="customerSelectorField">
                                                                            <!-- Customer selector label -->
                                                                            <label for="ToCustomer" class="customerSelectorFieldLabel customerSelectorFieldLabelRequired">
                                                                                [% Translate("To") | html %]:
                                                                            </label>

                                                                            <!-- Customer selector input area -->
                                                                            <div class="customerSelectorFieldInput" aria-labelledby="customerSelectorLabel">
                                                                                <!-- Selected customers -->
                                                                                <!-- Customer data as JSON -->
                                                                                <script class="customerData" type="application/json">
                                                                                [
                                                                                    [% RenderBlockStart("MultipleCustomer") %]
                                                                                    {
                                                                                        "customerKey": "[% Data.CustomerKey | html %]",
                                                                                        "customerElement": "[% Data.CustomerElement | html %]",
                                                                                        "count": "[% Data.Count | html %]",
                                                                                        "selected": [% IF Data.CustomerSelected %]true[% ELSE %]false[% END %],
                                                                                        "disabled": [% IF Data.CustomerDisabled %]true[% ELSE %]false[% END %],
                                                                                        "errors": {
                                                                                            "explanation": "[% RenderBlockStart("CustomerErrorExplantion") %][% Translate("Please remove this entry and enter a new one with the correct value.") | html %][% RenderBlockEnd("CustomerErrorExplantion") %]",
                                                                                            "generic": "[% RenderBlockStart("CustomerGenericServerErrorMsg") %][% Translate("This field is required.") | html %][% RenderBlockEnd("CustomerGenericServerErrorMsg") %]",
                                                                                            "invalidConfig": "[% RenderBlockStart("InvalidConfigServerErrorMsg") %][% Translate("This email address is not allowed due to the system configuration.") | html %][% RenderBlockEnd("InvalidConfigServerErrorMsg") %]",
                                                                                            "invalidMX": "[% RenderBlockStart("InvalidMXServerErrorMsg") %][% Translate("This email address failed MX check.") | html %][% RenderBlockEnd("InvalidMXServerErrorMsg") %]",
                                                                                            "invalidDNS": "[% RenderBlockStart("InvalidDNSServerErrorMsg") %][% Translate("DNS problem, please check your configuration and the error log.") | html %][% RenderBlockEnd("InvalidDNSServerErrorMsg") %]",
                                                                                            "invalidSyntax": "[% RenderBlockStart("InvalidSyntaxServerErrorMsg") %][% Translate("The syntax of this email address is incorrect.") | html %][% RenderBlockEnd("InvalidSyntaxServerErrorMsg") %]",
                                                                                            "isDuplicated": "[% RenderBlockStart("IsDuplicatedServerErrorMsg") %][% Translate("This address already exists on the address list.") | html %][% RenderBlockEnd("IsDuplicatedServerErrorMsg") %]"
                                                                                        }
                                                                                    }[% IF !loop.last %],[% END %]
                                                                                    [% RenderBlockEnd("MultipleCustomer") %]
                                                                                ]
                                                                                </script>
                                                                                <!-- Customer container (will be populated by JS) -->
                                                                                <div id="customerContainer"></div>

                                                                                <!-- Customer search input -->
                                                                                <input id="ToCustomer" type="text" name="ToCustomer" value="" class="customerSelectorFieldInputElement" autocomplete="off" aria-label="[% Translate("Search for customer") | html %]" aria-invalid="[% IF Data.ToInvalid %]true[% ELSE %]false[% END %]">

                                                                                <!-- Address book button -->
                                                                                [% IF Data.OptionCustomerUserAddressBook %]
                                                                                <button type="button" class="customerSelectorFieldInputAddressBook" data-recipient-field="ToCustomer" data-recipient-field-label="[% Translate("To") | html %]" data-recipient-type="Email" aria-label="[% Translate("Open address book") | html %]">
                                                                                    <img src="[% Config("Frontend::ImagePath") %]icons/address-book.svg" width="16" height="16" alt="[% Translate("Address book") | html %]">
                                                                                </button>
                                                                                [% END %]
                                                                            </div>

                                                                            <!-- Suggestion dropdown -->
                                                                            <div class="customerSelectorFieldSuggest" role="listbox" aria-label="[% Translate("Customer suggestions") | html %]"></div>
                                                                        </div>

                                                                        <!-- Error messages container -->
                                                                        <div class="customerSelectorErrorMessages" role="alert">
                                                                            [% RenderBlockStart("ToServerErrorMsg") %]
                                                                            <p>[% Translate("Please include at least one recipient") | html %]</p>
                                                                            [% RenderBlockEnd("ToServerErrorMsg") %]
                                                                            [% RenderBlockStart("ToIsLocalAddressServerErrorMsg") %]
                                                                            <p>[% Translate("This address is registered as system address and cannot be used: %s", Data.To) | html %]</p>
                                                                            [% RenderBlockEnd("ToIsLocalAddressServerErrorMsg") %]
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="mod modCustomerSelector">
                                                                <div class="inner"
                                                                    data-input-name="CcCustomerKey_"
                                                                    data-input-text-name="CcCustomerTicketText_"
                                                                    data-input-customer-queue="CcCustomerQueue_"
                                                                    data-input-type="cc"
                                                                    data-input-counter-name="CustomerTicketCounterCcCustomer"
                                                                    data-input-selected-name="CcCustomerSelected"
                                                                    data-selected-customer-allow="false"
                                                                    data-selected-customer-field-name="CcSelectedCustomerUser"
                                                                    data-remove-icon-path="[% Config("Frontend::ImagePath") %]icons/xmark-gray.svg"
                                                                    data-url="[% Env("Baselink") %]Action=AgentCustomerSearch;MaxResults=20"
                                                                    data-customers="[]">

                                                                    <div class="customerSelector" role="form">
                                                                        <div class="customerSelectorField">
                                                                            <!-- Customer selector label -->
                                                                            <label for="CcCustomer" class="customerSelectorFieldLabel">
                                                                                [% Translate("Cc") | html %]:
                                                                            </label>

                                                                            <!-- Customer selector input area -->
                                                                            <div class="customerSelectorFieldInput" aria-labelledby="customerSelectorLabel">
                                                                                <!-- Selected customers -->
                                                                                <!-- Customer data as JSON -->
                                                                                <script class="customerData" type="application/json">
                                                                                [
                                                                                    [% RenderBlockStart("CcMultipleCustomer") %]
                                                                                    {
                                                                                        "customerKey": "[% Data.CustomerKey | html %]",
                                                                                        "customerElement": "[% Data.CustomerElement | html %]",
                                                                                        "count": "[% Data.Count | html %]",
                                                                                        "selected": [% IF Data.CustomerSelected %]true[% ELSE %]false[% END %],
                                                                                        "disabled": [% IF Data.CustomerDisabled %]true[% ELSE %]false[% END %],
                                                                                        "errors": {
                                                                                            "explanation": "[% RenderBlockStart("CcCustomerErrorExplantion") %][% Translate("Please remove this entry and enter a new one with the correct value.") | html %][% RenderBlockEnd("CcCustomerErrorExplantion") %]",
                                                                                            "generic": "[% RenderBlockStart("CcCustomerGenericServerErrorMsg") %][% Translate("This field is required.") | html %][% RenderBlockEnd("CcCustomerGenericServerErrorMsg") %]",
                                                                                            "invalidConfig": "[% RenderBlockStart("CcInvalidConfigServerErrorMsg") %][% Translate("This email address is not allowed due to the system configuration.") | html %][% RenderBlockEnd("CcInvalidConfigServerErrorMsg") %]",
                                                                                            "invalidMX": "[% RenderBlockStart("CcInvalidMXServerErrorMsg") %][% Translate("This email address failed MX check.") | html %][% RenderBlockEnd("CcInvalidMXServerErrorMsg") %]",
                                                                                            "invalidDNS": "[% RenderBlockStart("CcInvalidDNSServerErrorMsg") %][% Translate("DNS problem, please check your configuration and the error log.") | html %][% RenderBlockEnd("CcInvalidDNSServerErrorMsg") %]",
                                                                                            "invalidSyntax": "[% RenderBlockStart("CcInvalidSyntaxServerErrorMsg") %][% Translate("The syntax of this email address is incorrect.") | html %][% RenderBlockEnd("CcInvalidSyntaxServerErrorMsg") %]",
                                                                                            "isDuplicated": "[% RenderBlockStart("CcIsDuplicatedServerErrorMsg") %][% Translate("This address already exists on the address list.") | html %][% RenderBlockEnd("CcIsDuplicatedServerErrorMsg") %]"
                                                                                        }
                                                                                    }[% IF !loop.last %],[% END %]
                                                                                    [% RenderBlockEnd("CcMultipleCustomer") %]
                                                                                ]
                                                                                </script>
                                                                                <!-- Customer container (will be populated by JS) -->
                                                                                <div id="ccCustomerContainer"></div>

                                                                                <!-- Customer search input -->
                                                                                <input id="CcCustomer" type="text" name="CcCustomer" value="" class="customerSelectorFieldInputElement  [% Data.CcIsLocalAddress | html %] [% Data.CcInvalid | html %]" autocomplete="off" aria-label="[% Translate("Search for customer") | html %]">

                                                                                <!-- Address book button -->
                                                                                [% IF Data.OptionCustomerUserAddressBook %]
                                                                                <button type="button" class="customerSelectorFieldInputAddressBook" data-recipient-field="CcCustomer" data-recipient-field-label="[% Translate("Cc") | html %]" data-recipient-type="Email" aria-label="[% Translate("Open address book") | html %]">
                                                                                    <img src="[% Config("Frontend::ImagePath") %]icons/address-book.svg" width="16" height="16" alt="[% Translate("Address book") | html %]">
                                                                                </button>
                                                                                [% END %]
                                                                            </div>

                                                                            <!-- Suggestion dropdown -->
                                                                            <div class="customerSelectorFieldSuggest" role="listbox" aria-label="[% Translate("Customer suggestions") | html %]"></div>
                                                                        </div>

                                                                        <!-- Error messages container -->
                                                                        <div class="customerSelectorErrorMessages" role="alert">
                                                                            [% RenderBlockStart("CcIsLocalAddressServerErrorMsg") %]
                                                                            <p>[% Translate("This address is registered as system address and cannot be used: %s", Data.Cc) | html %]</p>
                                                                            [% RenderBlockEnd("CcIsLocalAddressServerErrorMsg") %]
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="mod modCustomerSelector">
                                                                <div class="inner"
                                                                    data-input-name="BccCustomerKey_"
                                                                    data-input-text-name="BccCustomerTicketText_"
                                                                    data-input-customer-queue="BccCustomerQueue_"
                                                                    data-input-type="bcc"
                                                                    data-input-counter-name="CustomerTicketCounterBccCustomer"
                                                                    data-input-selected-name="BccCustomerSelected"
                                                                    data-selected-customer-allow="false"
                                                                    data-selected-customer-field-name="BccSelectedCustomerUser"
                                                                    data-remove-icon-path="[% Config("Frontend::ImagePath") %]icons/xmark-gray.svg"
                                                                    data-url="[% Env("Baselink") %]Action=AgentCustomerSearch;MaxResults=20"
                                                                    data-customers="[]">

                                                                    <div class="customerSelector" role="form">
                                                                        <div class="customerSelectorField">
                                                                            <!-- Customer selector label -->
                                                                            <label for="BccCustomer" class="customerSelectorFieldLabel">
                                                                                [% Translate("Bcc") | html %]:
                                                                            </label>

                                                                            <!-- Customer selector input area -->
                                                                            <div class="customerSelectorFieldInput" aria-labelledby="customerSelectorLabel">
                                                                                <!-- Selected customers -->
                                                                                <!-- Customer data as JSON -->
                                                                                <script class="customerData" type="application/json">
                                                                                [
                                                                                    [% RenderBlockStart("BccMultipleCustomer") %]
                                                                                    {
                                                                                        "customerKey": "[% Data.CustomerKey | html %]",
                                                                                        "customerElement": "[% Data.CustomerElement | html %]",
                                                                                        "count": "[% Data.Count | html %]",
                                                                                        "selected": [% IF Data.CustomerSelected %]true[% ELSE %]false[% END %],
                                                                                        "disabled": [% IF Data.CustomerDisabled %]true[% ELSE %]false[% END %],
                                                                                        "errors": {
                                                                                            "explanation": "[% RenderBlockStart("BccCustomerErrorExplantion") %][% Translate("Please remove this entry and enter a new one with the correct value.") | html %][% RenderBlockEnd("BccCustomerErrorExplantion") %]",
                                                                                            "generic": "[% RenderBlockStart("BccCustomerGenericServerErrorMsg") %][% Translate("This field is required.") | html %][% RenderBlockEnd("BccCustomerGenericServerErrorMsg") %]",
                                                                                            "invalidConfig": "[% RenderBlockStart("BccInvalidConfigServerErrorMsg") %][% Translate("This email address is not allowed due to the system configuration.") | html %][% RenderBlockEnd("BccInvalidConfigServerErrorMsg") %]",
                                                                                            "invalidMX": "[% RenderBlockStart("BccInvalidMXServerErrorMsg") %][% Translate("This email address failed MX check.") | html %][% RenderBlockEnd("BccInvalidMXServerErrorMsg") %]",
                                                                                            "invalidDNS": "[% RenderBlockStart("BccInvalidDNSServerErrorMsg") %][% Translate("DNS problem, please check your configuration and the error log.") | html %][% RenderBlockEnd("BccInvalidDNSServerErrorMsg") %]",
                                                                                            "invalidSyntax": "[% RenderBlockStart("BccInvalidSyntaxServerErrorMsg") %][% Translate("The syntax of this email address is incorrect.") | html %][% RenderBlockEnd("BccInvalidSyntaxServerErrorMsg") %]",
                                                                                            "isDuplicated": "[% RenderBlockStart("BccIsDuplicatedServerErrorMsg") %][% Translate("This address already exists on the address list.") | html %][% RenderBlockEnd("BccIsDuplicatedServerErrorMsg") %]"
                                                                                        }
                                                                                    }[% IF !loop.last %],[% END %]
                                                                                    [% RenderBlockEnd("BccMultipleCustomer") %]
                                                                                ]
                                                                                </script>
                                                                                <!-- Customer container (will be populated by JS) -->
                                                                                <div id="bccCustomerContainer"></div>

                                                                                <!-- Customer search input -->
                                                                                <input id="BccCustomer" type="text" name="BccCustomer" value="" class="customerSelectorFieldInputElement  [% Data.BccIsLocalAddress | html %] [% Data.BccInvalid | html %]" autocomplete="off" aria-label="[% Translate("Search for customer") | html %]">

                                                                                <!-- Address book button -->
                                                                                [% IF Data.OptionCustomerUserAddressBook %]
                                                                                <button type="button" class="customerSelectorFieldInputAddressBook" data-recipient-field="BccCustomer" data-recipient-field-label="[% Translate("Bcc") | html %]" data-recipient-type="Email" aria-label="[% Translate("Open address book") | html %]">
                                                                                    <img src="[% Config("Frontend::ImagePath") %]icons/address-book.svg" width="16" height="16" alt="[% Translate("Address book") | html %]">
                                                                                </button>
                                                                                [% END %]
                                                                            </div>

                                                                            <!-- Suggestion dropdown -->
                                                                            <div class="customerSelectorFieldSuggest" role="listbox" aria-label="[% Translate("Customer suggestions") | html %]"></div>
                                                                        </div>

                                                                        <!-- Error messages container -->
                                                                        <div class="customerSelectorErrorMessages" role="alert">
                                                                            [% RenderBlockStart("BccIsLocalAddressServerErrorMsg") %]
                                                                            <p>[% Translate("This address is registered as system address and cannot be used: %s", Data.Bcc) | html %]</p>
                                                                            [% RenderBlockEnd("BccIsLocalAddressServerErrorMsg") %]
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                [% RenderBlockStart("BccMultipleCustomerCounter") %]
                                                                <input type="hidden" id="CustomerTicketCounterBccCustomer" name="CustomerTicketCounterBccCustomer" value="[% Data.CustomerCounter | html %]">
                                                                [% RenderBlockEnd("BccMultipleCustomerCounter") %]
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="Mandatory" for="Subject"><span class="Marker">*</span>[% Translate("Subject") | html %]:</label>
                                                            <div class="Field">
                                                                <input type="text" name="Subject" id="Subject" value="[% Data.Subject | html %]" class="W50pc Validate_Required [% Data.SubjectInvalid | html %]" />
                                                                <div id="SubjectError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("This field is required.") | html %]</p>
                                                                </div>
                                                                <div id="SubjectServerError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("This field is required.") | html %]</p>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3">
                                                        [% RenderBlockStart("Option") %]
                                                            <div class="col-12 gy-3">
                                                                <label for="[% Data.Name | html %]">[% Translate(Data.Key) | html %]:</label>
                                                                <div class="Field">
                                                                    [% Data.Value %]
                                                                    <div id="[% Data.Name | html %]ServerError" class="TooltipErrorMessage">
                                                                        <p>[% Data.Invalid | html %]</p>
                                                                    </div>
                                                                    [% IF Data.FieldExplanation.length %]
                                                                    <p class="FieldExplanation">[% Translate(Data.FieldExplanation) | html %]</p>
                                                                    [% END %]
                                                                </div>
                                                            </div>
                                                        [% RenderBlockEnd("Option") %]
                                                        </div>

                                                        [% RenderBlockStart("TicketOptions") %]
                                                        <div class="col-12">
                                                            <label>[% Translate("Options") | html %]:</label>
                                                            <div class="Field">
                                                                <!-- OutputFilterHook_TicketOptionsBegin -->
                                                                <!-- OutputFilterHook_TicketOptionsEnd -->
                                                            </div>
                                                        </div>
                                                        [% RenderBlockEnd("TicketOptions") %]

                                                        <div class="col-12">
                                                            <label class="Mandatory" for="RichText"><span class="Marker">*</span>[% Translate("Text") | html %]:</label>
                                                            <div class="RichTextField">
                                                                <textarea id="RichText" name="Body" rows="15" cols="[% Config(" Ticket::Frontend::TextAreaEmail") %]" class="RichText Validate_Required [% Data.BodyInvalid | html %]">[% Data.Body | html %]</textarea>
                                                                <div id="RichTextError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("This field is required.") | html %]</p>
                                                                </div>
                                                                <div id="RichTextServerError" class="TooltipErrorMessage">
                                                                    <p>[% Translate("This field is required.") | html %]</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="Field component-attachment">
                                                                [% INCLUDE "FormElements/AttachmentList.tt" %]
                                                            </div>
                                                        </div>
                                                        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-2 gy-3">
                                                            <div class="col-12">
                                                                <label for="IsVisibleForCustomer">[% Translate("Visible for customer") | html %]</label>
                                                                <div class="Field">
                                                                    <input type="checkbox" id="IsVisibleForCustomer" name="IsVisibleForCustomer" value="1" [% IF Data.IsVisibleForCustomer %]checked="checked" [% END %] />
                                                                </div>
                                                            </div>
                                                            [% RenderBlockStart("TimeUnits") %]
                                                            <div class="col-12">
                                                                [% Data.TimeUnitsBlock %]
                                                            </div>
                                                            [% RenderBlockEnd("TimeUnits") %]
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </main>

                                <div class="row">
                                    <div class="col-12">
                                        <div class="col-12">
                                            <div class="mod modFormSubmitArea">
                                                <div class="inner">
                                                    <div class="formSubmitArea">
                                                        <div class="formSubmitAreaCancel">
                                                            [% RenderBlockStart("TicketBack") %]
                                                                <a class="CancelClosePopup btn-cancel-ghost btn-main btn-width-md" href="#">[% Translate("Undo & close") | html %]</a>
                                                            [% RenderBlockEnd("TicketBack") %]
                                                            [% RenderBlockStart("PropertiesLock") %]
                                                            <div class="ticket-locked">
                                                                <a class="UndoClosePopup btn-cancel-ghost btn-main btn-width-md" href="[% Env("Baselink") %]Action=AgentTicketLock;Subaction=Unlock;TicketID=[% Data.TicketID %][% IF Data.PreviousOwner %];PreviousOwner=[% Data.PreviousOwner %][% END %];[% Env("ChallengeTokenParam") | html %]">
                                                                    [% Translate("Unlock and close popup") | html %]
                                                                </a>
                                                            </div>
                                                            [% RenderBlockEnd("PropertiesLock") %]
                                                        </div>
                                                        <div class="formSubmitAreaSubmit">
                                                            [% INCLUDE "FormElements/DraftButtons.tt" %]
                                                            <button class="CallForAction Primary btn-main btn-primary btn-width-md" id="submitRichText" accesskey="g" title="[% Translate("Send mail") | html %] (g)" type="submit" value="[% Translate("Send mail") | html %]">
                                                            <span>[% Translate("Send mail") | html %]</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
