<div class="field-wrapper">
    <label for="">[% Translate("Add attachments of other articles") | html %]</label>
    <div class="Field">
        <input type="hidden" id="ReusedArticleFileIDs" name="ReusedArticleFileIDs" value="[% Data.ReusedArticleFileIDs | html %]" />
        [% PROCESS 'AttachmentList.tt' %]
        <div>
            <button id="ZnunyTicketAttachmentsSelectAll" type="button" class="CallForAction btn-main btn-width-lg btn-cancel-ghost">
                <span>[% Translate("Select all attachments") | html %]</span>
            </button>
        </div>
    </div>
</div>
