## nofilter(TidyAll::Plugin::Znuny::TT::Breadcrumb)

<div id="CloneProcessDialog">
    <form action="[% Env("CGIHandle") %]" method="post" id="ProcessCloneForm">
        <input type="hidden" name="Action" value="[% Env("Action") %]" />
        <input type="hidden" name="Subaction" value="ProcessClone" />
        <input type="hidden" name="ChallengeToken" value="[% Env("UserChallengeToken") | html %]" />
        <input type="hidden" name="ID" id="ProcessCloneID" value="" />
        <p>[% Translate("Please enter a name for the cloned process. The original process stays unchanged.") | html %]</p>
        <div class="field-wrapper SpacingTop">
            <label for="ProcessCloneName">[% Translate("Process Name") | html %]</label>
            <div class="Field">
                <input type="text" id="ProcessCloneName" name="Name" maxlength="200" class="W100pc" />
            </div>
        </div>
    </form>
</div>
<div id="CloneEntityDialog">
    <p>[% Translate("Please enter a name for the cloned element. The original element stays unchanged.") | html %]</p>
    <p class="SpacingTop"><strong><span class="EntityName"></span></strong></p>
    <div class="field-wrapper SpacingTop">
        <label for="CloneEntityName">[% Translate("Name") | html %]</label>
        <div class="Field">
            <input type="text" id="CloneEntityName" maxlength="200" class="W100pc" />
        </div>
    </div>
</div>
