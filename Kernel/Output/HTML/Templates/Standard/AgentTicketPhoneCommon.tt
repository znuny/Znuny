[% TicketFrontendConfig = Config("Ticket::Frontend::" _ Env("Action") ) %]
<div class="layoutPopUpSidebar">
    <main class="sectionContent">
        <div class="container-fluid ARIARoleMain" role="main">
            <div class="row">
                <div class="col-xs-12 order-1">
                    <div class="mod modForm" >
                        <div class="inner">
                            <form action="[% Env("CGIHandle") %]" method="post" enctype="multipart/form-data" name="compose" class="Validate PreventMultipleSubmits">
                                <input type="hidden" name="Action"    value="[% Env("Action") %]"/>
                                <input type="hidden" name="Subaction" value="Store"/>
                                <input type="hidden" name="FormID"    value="[% Data.FormID | html %]"/>
                                <input type="hidden" name="TicketID"  value="[% Data.TicketID | html %]"/>
                                <input type="hidden" name="FormDraftTitle" value="[% Data.FormDraftTitle | html %]"/>
                                <input type="hidden" name="FormDraftID" value="[% Data.FormDraftID | html %]"/>
                                <input type="hidden" name="FormDraftAction" id="FormDraftAction" />

                                [% RenderBlockStart("PropertiesLockNotify") %]
                                [% INCLUDE "Modules/Alert.tt"
                                    Data = {
                                        message = Translate("The ticket has been locked") _ ".",
                                        type = "warning",
                                    }
                                %]
                                [% RenderBlockEnd("PropertiesLockNotify") %]

                                    <div class="row">
                                        <div class="col-12">
                                            [% INCLUDE "FormElements/DraftNotifications.tt" %]

                                            [% IF TicketFrontendConfig.State %]
                                            <div class="mod modCard" >
                                                <div class="inner">
                                                    <div class="cardTitle">
                                                        <h2>[% Translate("Ticket Data") | html %]</h2>
                                                        <span class="cardTitleTrigger"></span>
                                                    </div>
                                                    <div class="cardContent">
                                                        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 gy-3">
                                                            <div class="col">
                                                                <label for="NextStateID">[% Translate("Next ticket state") | html %]:</label>
                                                                <div class="Field">
                                                                    [% Data.NextStatesStrg %]
                                                                </div>
                                                            </div>

                                                            <div class="col">
                                                                <label>[% Translate("Pending date") | html %]:</label>
                                                                <div class="Field no-background">
                                                                    <div class="select-field-wrapper">[% Data.PendingDateString %]</div>
                                                                    <div id="DayServerError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("Date invalid!") | html %]</p>
                                                                    </div>
                                                                    <div id="HourServerError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("Date invalid!") | html %]</p>
                                                                    </div>
                                                                    <p class="FieldExplanation">[% Translate("For all pending* states.") | html %]</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            [% END %]

                                            [% IF !TicketFrontendConfig.DynamicField.empty %]
                                            <div class="mod modCard" >
                                                <div class="inner">
                                                    <div class="cardTitle">
                                                        <h2>[% Translate("Dynamic Info") | html %]</h2>
                                                        <span class="cardTitleTrigger"></span>
                                                    </div>
                                                    <div class="cardContent">
                                                        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 gy-3">
                                                            [% RenderBlockStart("DynamicField") %]
                                                            <div class="col">
                                                                <div class="mod modDynamicField">
                                                                    <div class="inner">
                                                                        <div class="dynamicField dynamicField[% Data.Name | html %] [% Data.Class | html %]">
                                                                            <div class="dynamicFieldLabel">
                                                                                <div class="label-wrapper">[% Data.Label %]</div>
                                                                            </div>
                                                                            <div class="dynamicFieldForm">
                                                                                [% Data.Field %]
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            [% RenderBlockEnd("DynamicField") %]
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            [% END %]

                                            <div class="mod modCard" >
                                                <div class="inner">
                                                    <div class="cardTitle">
                                                        <h2>[% Translate("Communication") | html %]</h2>
                                                        <span class="cardTitleTrigger"></span>
                                                    </div>
                                                    <div class="cardContent">
                                                        <div class="row gy-3">
                                                            <div class="col-12">
                                                                <label class="Mandatory" for="Subject">
                                                                    <span class="Marker">*</span>
                                                                    [% Translate("Subject") | html %]:
                                                                </label>
                                                                <div class="Field">
                                                                    <input type="text" name="Subject" id="Subject" value="[% Data.Subject | html %]" class="Validate_Required [% Data.SubjectInvalid | html %] W75pc"/>
                                                                    <div id="SubjectError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("This field is required.") | html %]</p>
                                                                    </div>
                                                                    <div id="SubjectServerError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("This field is required.") | html %]</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            [% RenderBlockStart("TicketOptions") %]
                                                            <div class="col-12">
                                                                <label>[% Translate("Options") | html %]:</label>
                                                                <div class="Field">
                                                                    <!-- OutputFilterHook_TicketOptionsBegin -->
                                                                    <!-- OutputFilterHook_TicketOptionsEnd -->
                                                                </div>
                                                            </div>
                                                            [% RenderBlockEnd("TicketOptions") %]

                                                            <div class="col-12">
                                                                <!-- OutputFilterHook_NoTicketOptionsFallback -->
                                                            </div>
                                                            [% RenderBlockStart("StandardTemplate") %]
                                                            <div class="col-12">
                                                                <label for="StandardTemplateID">[% Translate("Text Template") | html %]:</label>
                                                                <div class="Field">
                                                                    [% Data.StandardTemplateStrg %]
                                                                    <p class="FieldExplanation">[% Translate("Setting a template will overwrite any text or attachment.") | html %]</p>
                                                                </div>
                                                            </div>
                                                            [% RenderBlockEnd("StandardTemplate") %]

                                                            <div class="col-12">
                                                                <label class="Mandatory" for="RichText">
                                                                    <span class="Marker">*</span>
                                                                    [% Translate("Text") | html %]:
                                                                </label>
                                                                <div id="RichTextField" class="RichTextField">
                                                                    <textarea id="RichText" name="Body" title="[% Translate("Message body") | html %]" rows="15" cols="[% Config("Ticket::Frontend::TextAreaNote") | html %]" class="RichText Validate_Required [% Data.BodyInvalid | html %]">[% Data.Body %]</textarea>
                                                                    <div id="RichTextError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("This field is required.") | html %]</p>
                                                                    </div>
                                                                    <div id="RichTextServerError" class="TooltipErrorMessage">
                                                                        <p>[% Translate("This field is required.") | html %]</p>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-12">
                                                                <div class="Field component-attachment">
                                                                    [% INCLUDE "FormElements/AttachmentList.tt" %]
                                                                </div>
                                                            </div>

                                                            [% RenderBlockStart("TimeUnits") %]
                                                            <div class="col">
                                                                [% Data.TimeUnitsBlock %]
                                                            </div>
                                                            [% RenderBlockEnd("TimeUnits") %]

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-12">
                                            <div class="col-12">
                                                <div class="mod modFormSubmitArea">
                                                    <div class="inner">
                                                        <div class="formSubmitArea">
                                                            <div class="formSubmitAreaCancel">
                                                                [% RenderBlockStart("TicketBack") %]
                                                                <a class="CancelClosePopup btn-cancel-ghost btn-main btn-width-md" href="#">[% Translate("Undo & close") | html %]</a>
                                                                [% RenderBlockEnd("TicketBack") %]
                                                                [% RenderBlockStart("PropertiesLock") %]
                                                                <div class="ticket-locked">
                                                                    <a class="UndoClosePopup btn-cancel-ghost btn-main btn-width-lg" href="[% Env("Baselink") %]Action=AgentTicketLock;Subaction=Unlock;TicketID=[% Data.TicketID %][% IF Data.PreviousOwner %];PreviousOwner=[% Data.PreviousOwner %][% END %];[% Env("ChallengeTokenParam") | html %]">
                                                                        [% Translate("Undo & close") | html %]
                                                                    </a>
                                                                </div>
                                                                [% RenderBlockEnd("PropertiesLock") %]
                                                            </div>
                                                            <div class="formSubmitAreaSubmit">
                                                                [% INCLUDE "FormElements/DraftButtons.tt" %]
                                                                <button class="CallForAction Primary btn-primary btn-main btn-width-md" id="submitRichText" accesskey="g" title="[% Translate("Submit") | html %] (g)" type="submit" value="[% Translate("Submit") | html %]">
                                                                    <span>[% Translate("Submit") | html %]</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <aside class="sectionSidebar">
        <div class="mod modSidebar">
            <div class="inner sidebarActive">
                <div class="sidebar">
                    <div class="sidebarTitle">
                        <h2>[% Translate("Information") | html %]</h2>
                    </div>
                    <div class="sidebarContent">
                        [% RenderBlockStart("CustomerTable") %]
                        <div class="mod modSidebarWidget">
                            <div class="inner">
                                <div class="sidebarWidgetTitle">
                                    <h3>[% Translate("Customer Information") | html %]</h3>
                                </div>
                                <div class="sidebarWidgetContent">
                                    <div class="mod modCustomerInformation">
                                        <div class="inner">
                                            <div id="CustomerInfo" class="WidgetSimple">
                                                <div class="Content">
                                                    [% Data.CustomerTable %]
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        [% RenderBlockEnd("CustomerTable") %]
                    </div>
                </div>
                <div class="sidebarTrigger">
                </div>
            </div>
        </div>
    </aside>
</div>
