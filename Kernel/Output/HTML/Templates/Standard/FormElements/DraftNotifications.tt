<!-- start DraftNotifications -->

[% IF Data.FormDraftTitle %]
    [% SET DraftMessage = "" %]
    [% IF Data.FormDraftMeta.ChangeTime == Data.FormDraftMeta.CreateTime %]
        [% SET DraftMessage = Translate("You have loaded the draft \"%s\".", Data.FormDraftTitle) %]
    [% ELSE %]
        [% IF Data.FormDraftMeta.ChangeBy == Env('UserID') %]
            [% SET DraftMessage = Translate("You have loaded the draft \"%s\". You last changed it %s.", Data.FormDraftTitle, Localize(Data.FormDraftMeta.ChangeTime, 'TimeShort')) %]
        [% ELSE %]
            [% SET DraftMessage = Translate("You have loaded the draft \"%s\". It was last changed %s by %s.", Data.FormDraftTitle, Localize(Data.FormDraftMeta.ChangeTime, 'TimeShort'), Data.FormDraftMeta.ChangeByName) %]
        [% END %]
    [% END %]

    [% INCLUDE "Modules/Alert.tt"
        Data = {
            message = DraftMessage,
            type = "notice"
        }
    %]
[% ELSIF Data.FormDraftForAction %]
    [% INCLUDE "Modules/Alert.tt"
        Data = {
            message = Translate("Please note that you have already one or more saved drafts for this action."),
            type = "warning"
        }
    %]
[% END %]

[% IF Data.FormDraftOutdated %]
    [% INCLUDE "Modules/Alert.tt"
        Data = {
            message = Translate("Please note that this draft is outdated because the ticket was modified since this draft was created."),
            type = "warning"
        }
    %]
[% END %]
<!-- end DraftNotifications -->
