[% IF Data.ShowSearchDialog %]
<div class="InnerContent main-search-component CustomerUserAdressBookSearch ContentColumn ARIARoleMain">
    <p class="FieldExplanation">
        [% Translate("Search for recipients and add the results as '%s'.", Data.RecipientFieldLabel) | html %]
    </p>
    <br>
    <form action="[% Env("CGIHandle") %]" method="post" id="SearchForm" class="CustomerUserAddressBookForm search-ticket">
        <input type="hidden" name="Action" value="[% Env("Action") %]" id="SearchAction"/>
        <input type="hidden" name="Subaction" value="Search"/>
        <input type="hidden" name="EmptySearch" value="[% Data.EmptySearch | html %]" id="EmptySearch"/>
        <input type="hidden" name="ShownAttributes" value="" id="ShownAttributes">
        <input type="hidden" name="RecipientType" value="[% Data.RecipientType | html %]" id="RecipientType" />
        <input type="hidden" name="RecipientField" value="[% Data.RecipientField | html %]" id="RecipientField" />
        <input type="hidden" name="RecipientFieldLabel" value="[% Data.RecipientFieldLabel | html %]" id="RecipientFieldLabel" />
        <input type="hidden" name="ExcludeUserLoginsJSON" value="" id="ExcludeUserLogins">
        <div class="top-section">
            <fieldset class="TableLike">
                <legend><span>[% Translate("Templates") | html %]</span></legend>
                <div class="field-wrapper search-template-header">
                    <label for="SearchProfile">[% Translate("Search template") | html %]</label>
                    <div class="Field create-tpm-btn">
                        <button id="SearchProfileNew" class="btn-main btn-ghost-sm" value="[% Translate("Create New") | html %]">
                            <span>[% Translate("Create New") | html %]</span>
                        </button>
                        <button id="SearchProfileDelete" class="btn-main Hidden btn-ghost-sm" value="[% Translate("Delete") | html %]">
                            <span>[% Translate("Delete") | html %]</span>
                        </button>
                    </div>
                </div>
                <div class="Field">
                    [% Data.ProfilesStrg %]
                    <div id="SearchProfileAddBlock" class="new-tpl-input">
                        <input type="text" name="Name" id="SearchProfileAddName"/>
                        <div class="create-tpm-btn">
                            <button class="btn-main btn-ghost-sm" type="button" title="[% Translate("Create Template") | html %]" id="SearchProfileAddAction">
                                <span>[% Translate("Add") | html %]</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="SaveProfileContainer">
                    <div class="align-item-left">
                        <input type="checkbox" name="SaveProfile" id="SaveProfile" value="1"/>
                    </div>
                    <label for="SaveProfile">[% Translate("Save changes in template") | html %]</label>
                </div>
            </fieldset>
        </div>

        <div class="bottom-section">
            <fieldset class="TableLike" id="SearchInsert">
                <legend><span>[% Translate("Filters in use") | html %]</span></legend>
            </fieldset>

            <fieldset class="TableLike">
                <legend><span>[% Translate("Additional filters") | html %]</span></legend>
                <div class="field-wrapper">
                    <label>[% Translate("Add another attribute") | html %]</label>
                    <div class="Field">
                        [% Data.AttributesStrg %]
                        <p class="FieldExplanation">[% Translate("The attributes with the identifier '(Customer)' are from the customer company.") | html %]</p>
                    </div>
                </div>
            </fieldset>
        </div>
    </form>

    <fieldset class="TableLike Hidden" id="SearchAttributesHidden">

        [% FOR SearchField IN Data.OutputSearchFields %]
        <div class="field-wrapper">
            <div class="label-wrapper">
                <label for="[% SearchField.Name | html %]" id="Label[% SearchField.Name | html %]">[% Translate(SearchField.Label) | html %]</label>
            </div>
            <div class="Field">
            [% IF SearchField.SelectionString %]
                [% SearchField.SelectionString %]
            [% ELSE %]
                <input type="text" name="[% SearchField.Name | html %]" placeholder="[% Translate("(e. g. Term* or *Term*)") | html %]" value="[% SearchField.Value | html %]" class="W50pc"/>
            [% END %]
                <a class="RemoveButton icon-hover" href="#" title="[% Translate("Remove this entry") | html %]">
                    <i class="fa fa-times"></i>
                    <span class="InvisibleText">[% Translate("Remove") | html %]</span>
                </a>
            </div>
        </div>
        [% END %]
[% RenderBlockStart("DynamicField") %]
        <div class="field-wrapper">
            [% Data.Label %]
            <div class="Field">
                [% Data.Field %]
                <a class="RemoveButton icon-hover" href="#" title="[% Translate("Remove this entry") | html %]">
                    <i class="fa fa-times"></i>
                    <span class="InvisibleText">[% Translate("Remove") | html %]</span>
                </a>
            </div>
        </div>
[% RenderBlockEnd("DynamicField") %]
        <div>
            [% Data.AttributesOrigStrg %]
        </div>
    </fieldset>
</div>

<div class="SearchFormButton Hidden">
    <button id="FormCancel" class="btn-main btn-width-md btn-cancel-ghost" type="button"><span>[% Translate("Cancel") | html %]</span></button>
    <button id="SearchFormSubmit" class="btn-primary btn-main btn-width-md" type="button" value="Run search"><span>[% Translate("Search") | html %]</span></button>
</div>
[% END %]
