<!-- start Notify -->

[% INCLUDE "Modules/Alert.tt"
    Data = {
        id = Data.ID,
        type = Data.BoxClass ? Data.BoxClass.lower : (Data.Priority ? Data.Priority.lower : 'notice'),
        message = (Data.Data || Translate(Data.Info)),
        hideAfter = Data.BoxClass.match('Success') ? 5 : 0,
        actionSeparator = Data.ActionSeparator,
        keepClosedForSession = Data.KeepClosedForSession || 0,
        actions = Data.Actions || (Data.Link ? "[
            {
                \"type\": \"" _ (Data.Priority ? Data.Priority.lower : 'notify') _ "\"" _ (Data.LinkClass ? ",\"classes\":\"" _ Data.LinkClass _ "\"" : "") _ "
                \"text\": \"" _ Translate("Continue") _ "\",
                \"url\": \"" _ Data.Link _ "\",
                \"class\": \"" _ Data.LinkClass _ "\",
            }
        ]" : "[]")
    }
%]
<!-- end Notify -->
