#
#  -->> Most Znuny configuration should be done via the Znuny web interface
#       and the SysConfig. Only for some configuration, such as database
#       credentials and customer data source changes, you should edit this
#       file. For changes to customer data sources you can copy the definitions
#       from Kernel/Config/Defaults.pm and paste them in this file.
#       Config.pm will not be overwritten when updating Znuny.
# --

package Kernel::Config;

use strict;
use warnings;
use utf8;

sub Load {
    my $Self = shift;

    # ---------------------------------------------------- #
    # database settings                                    #
    # ---------------------------------------------------- #

    # The database host
    $Self->{DatabaseHost} = '127.0.0.1';

    # The database name
    $Self->{Database} = 'znuny';

    # The database user
    $Self->{DatabaseUser} = 'znuny';

    # The password of database user. Instead of plain text, you can store this (and other
    # sensitive values below, such as LDAP bind passwords) as real, key-based ciphertext using
    # bin/znuny.Console.pl Maint::Secret::Encrypt (see Kernel::System::Crypt::Secret
    # for details, including how to configure the required encryption key).
    # (Maint::Database::PasswordCrypt also exists, but only produces a fixed, keyless
    # obfuscation - not real encryption - and is kept for backward compatibility only.)
    $Self->{DatabasePw} = 'some-pass';

    # The database DSN for MySQL ==> more: "perldoc DBD::mysql"
    $Self->{DatabaseDSN} = "DBI:mysql:database=$Self->{Database};host=$Self->{DatabaseHost};";

    # The database DSN for MariaDB ==> more: "perldoc DBD::MariaDB"
#    $Self->{DatabaseDSN} = "DBI:MariaDB:database=$Self->{Database};host=$Self->{DatabaseHost};";
    # The database DSN for PostgreSQL ==> more: "perldoc DBD::Pg"
    # if you want to use a local socket connection
#    $Self->{DatabaseDSN} = "DBI:Pg:dbname=$Self->{Database};";
    # if you want to use a TCP/IP connection
#    $Self->{DatabaseDSN} = "DBI:Pg:dbname=$Self->{Database};host=$Self->{DatabaseHost};";

    # The database DSN for Oracle ==> more: "perldoc DBD::oracle"
#    $Self->{DatabaseDSN} = "DBI:Oracle://$Self->{DatabaseHost}:1521/$Self->{Database}";
#
#    $ENV{ORACLE_HOME}     = '/path/to/your/oracle';
#    $ENV{NLS_DATE_FORMAT} = 'YYYY-MM-DD HH24:MI:SS';
#    $ENV{NLS_LANG}        = 'AMERICAN_AMERICA.AL32UTF8';

    # ---------------------------------------------------- #
    # encryption key for sensitive config values            #
    # (DatabasePw, AuthModule::LDAP::SearchUserPw, ...)     #
    # ---------------------------------------------------- #
    # If you encrypt any config value with
    # "bin/znuny.Console.pl Maint::Secret::Encrypt", the key used to encrypt/decrypt it must
    # be available at runtime. Do NOT store the key itself in this file - use one of:
    #   - the ZNUNY_CONFIG_SECRET_KEY environment variable (e.g. set for the webserver process), or
    #   - a key file outside of the webroot, referenced here, with permissions 0600:
    # $Self->{ConfigSecretKeyFile} = '/etc/znuny/config_secret.key';

    # ---------------------------------------------------- #
    # fs root directory
    # ---------------------------------------------------- #
    $Self->{Home} = '/opt/znuny';

    # ---------------------------------------------------- #
    # insert your own config settings "here"               #
    # config settings taken from Kernel/Config/Defaults.pm #
    # ---------------------------------------------------- #
    # $Self->{SessionUseCookie} = 0;
    # $Self->{CheckMXRecord} = 0;

    # ---------------------------------------------------- #

    # ---------------------------------------------------- #
    # data inserted by installer                           #
    # ---------------------------------------------------- #
    # $DIBI$

    # ---------------------------------------------------- #
    # ---------------------------------------------------- #
    #                                                      #
    # end of your own config options!!!                    #
    #                                                      #
    # ---------------------------------------------------- #
    # ---------------------------------------------------- #

    return 1;
}

# ---------------------------------------------------- #
# needed system stuff (don't edit this)                #
# ---------------------------------------------------- #

use Kernel::Config::Defaults; # import Translatable()
use parent qw(Kernel::Config::Defaults);

# -----------------------------------------------------#

1;
